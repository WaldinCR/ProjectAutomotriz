// SGI Automotriz — Esquema de Base de Datos
// Fuente de verdad: todas las tablas del sistema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── TABLAS ─────────────────────────────────────────

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  usuario       String   @unique
  passwordHash  String
  rol           String   @default("CAJERO") // ADMINISTRADOR | CAJERO | SUPERVISOR | TECNICO
  activo        Boolean  @default(true)
  intentosFallidos Int     @default(0)  // RF-06: bloqueo tras 5 intentos
  bloqueadoHasta   DateTime?
  ultimoAcceso     DateTime?           // RF-05
  debeCambiarPassword Boolean @default(false) // Contraseña temporal (usuario inicial o restablecida)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ventas        Venta[]
  ordenes       OrdenTrabajo[] @relation("OrdenCreador")
  ordenesTecnico OrdenTrabajo[] @relation("OrdenTecnico")
  cierres       CierreCaja[]
  movimientos   MovimientoInventario[]
  auditLogs     AuditLog[]
}

model Producto {
  id             Int      @id @default(autoincrement())
  nombre         String
  codigoBarras   String?  @unique
  codigoInterno  String   @unique
  categoria      String
  precioCompra   Float
  precioVenta    Float
  stock          Int      @default(0)
  stockMinimo    Int      @default(5)
  exentoItbis    Boolean  @default(false) // Productos exentos de ITBIS
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  detallesVenta  DetalleVenta[]
  detallesOrden  DetalleOrden[]
  movimientos    MovimientoInventario[]
}

model Venta {
  id               Int         @id @default(autoincrement())
  numeroFactura    String      @unique
  fecha            DateTime    @default(now())
  usuarioId        Int
  usuario          Usuario     @relation(fields: [usuarioId], references: [id])
  subtotal         Float       @default(0) // Base imponible + exento, sin ITBIS
  itbis            Float       @default(0)
  descuento        Float       @default(0) // Descuento global (RF-12)
  total            Float
  // Comprobante fiscal (DGII). ncf es null si no se emiten comprobantes.
  tipoComprobante  String?     // B01 crédito fiscal | B02 consumo | B14 régimen especial | B15 gubernamental
  ncf              String?     @unique
  clienteNombre    String?
  clienteRnc       String?
  metodoPago       String      // EFECTIVO | TARJETA | TRANSFERENCIA
  estado           String      @default("CONFIRMADA") // CONFIRMADA | ANULADA
  motivoAnulacion  String?

  detalles         DetalleVenta[]
  ordenTrabajo     OrdenTrabajo?

  @@index([fecha])
}

model DetalleVenta {
  id              Int       @id @default(autoincrement())
  ventaId         Int
  venta           Venta     @relation(fields: [ventaId], references: [id])
  productoId      Int?
  producto        Producto? @relation(fields: [productoId], references: [id])
  servicio        String?
  cantidad        Int
  precioUnitario  Float
  descuento       Float     @default(0)
  itbis           Float     @default(0)
  subtotal        Float
}

model OrdenTrabajo {
  id             Int      @id @default(autoincrement())
  vehiculo       String
  placa          String?  // RF-29
  cliente        String
  telefono       String?
  descripcion    String?
  usuarioId      Int
  usuario        Usuario  @relation("OrdenCreador", fields: [usuarioId], references: [id])
  tecnicoId      Int?
  tecnico        Usuario? @relation("OrdenTecnico", fields: [tecnicoId], references: [id])
  estado         String   @default("PENDIENTE") // PENDIENTE | EN_PROCESO | COMPLETADA | FACTURADA | CANCELADA
  total          Float    @default(0)
  fechaCreacion  DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ventaId        Int?     @unique
  venta          Venta?   @relation(fields: [ventaId], references: [id])

  detalles       DetalleOrden[]

  @@index([fechaCreacion])
  @@index([tecnicoId])
}

model DetalleOrden {
  id              Int          @id @default(autoincrement())
  ordenId         Int
  orden           OrdenTrabajo @relation(fields: [ordenId], references: [id])
  productoId      Int?
  producto        Producto?    @relation(fields: [productoId], references: [id])
  servicio        String
  cantidad        Int          @default(1)
  precioUnitario  Float
  subtotal        Float
}

model MovimientoInventario {
  id          Int            @id @default(autoincrement())
  productoId  Int
  producto    Producto       @relation(fields: [productoId], references: [id])
  usuarioId   Int
  usuario     Usuario        @relation(fields: [usuarioId], references: [id])
  tipo        String         // ENTRADA | SALIDA | AJUSTE
  cantidad    Int            // Positivo suma stock, negativo lo resta (solo AJUSTE)
  motivo      String
  fecha       DateTime       @default(now())

  @@index([productoId, fecha])
}

model CierreCaja {
  id                Int      @id @default(autoincrement())
  fecha             DateTime @default(now())
  usuarioId         Int
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])
  totalVentas       Float
  efectivoEsperado  Float
  efectivoContado   Float
  diferencia        Float
  observaciones     String?
  confirmado        Boolean  @default(false)

  @@index([fecha])
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  tabla            String
  accion           String
  registroId       Int?
  usuarioId        Int?
  usuario          Usuario? @relation(fields: [usuarioId], references: [id])
  datosAnteriores  String?
  datosNuevos      String?
  ipAddress        String?
  fecha            DateTime @default(now())

  @@index([fecha])
}

// Datos de la empresa y parámetros fiscales/operativos (una sola fila, id = 1)
model Configuracion {
  id                   Int      @id @default(1)
  nombreEmpresa        String   @default("Repuestos Ceballos")
  eslogan              String?  @default("Repuestos y Taller Automotriz")
  rnc                  String?
  direccion            String?
  telefono             String?
  email                String?
  tasaItbis            Float    @default(0.18)
  preciosIncluyenItbis Boolean  @default(true) // Precio de venta ya trae el ITBIS
  emitirNcf            Boolean  @default(false)
  // Impresora térmica ESC/POS: NINGUNA | RED (tcp://ip:9100) | COMPARTIDA (ruta de impresora compartida de Windows)
  impresoraTipo        String   @default("NINGUNA")
  impresoraDestino     String?
  impresoraAncho       Int      @default(48)  // Caracteres por línea (80 mm = 48, 58 mm = 32)
  imprimirAutomatico   Boolean  @default(false)
  piePagina            String?  @default("¡Gracias por su compra!")
  updatedAt            DateTime @updatedAt
}

// Secuencias de Números de Comprobante Fiscal autorizadas por la DGII
model SecuenciaNcf {
  id           Int       @id @default(autoincrement())
  tipo         String    @unique // B01 | B02 | B14 | B15
  descripcion  String
  siguiente    Int       @default(1)
  hasta        Int
  vencimiento  DateTime?
  activo       Boolean   @default(true)
  updatedAt    DateTime  @updatedAt
}

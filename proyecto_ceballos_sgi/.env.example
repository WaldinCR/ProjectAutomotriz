# Copie este archivo como .env y ajuste los valores.

# Ruta de la base SQLite, RELATIVA a la carpeta prisma/
# (con este valor el archivo queda en prisma/prisma/sgi_database.db)
DATABASE_URL="file:./prisma/sgi_database.db"

# Clave para firmar los tokens de la API remota. Use 32+ caracteres aleatorios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si falta o es insegura, se genera una aleatoria en cada inicio.
JWT_SECRET=""

# API de supervisión remota (solo lectura)
REMOTE_API_ENABLED=true
# 127.0.0.1 = solo este equipo. Exponer únicamente mediante un túnel cifrado (RNF-07).
REMOTE_API_HOST=127.0.0.1
PORT=3000

# Opcionales
# BACKUP_DIR=C:\respaldos\sgi
# REPORTS_DIR=C:\reportes\sgi
